     "output_type": "stream",
     "text": [
      "Matrix A:\n",
      "[[1 2]\n",
      " [3 4]]\n",
      "Matrix B:\n",
      "[[5 6]\n",
      " [7 8]]\n",
      "Addition of two Matrices:\n",
      "[[ 6  8]\n",
      " [10 12]]\n"
     ]
