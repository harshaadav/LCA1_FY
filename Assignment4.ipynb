   ],
   "source": [
    "import numpy as np\n",
    "A=np.array(([1,2],[3,4]))\n",
    "B=np.array(([5,6],[7,8]))\n",
    "C=A+B\n",
    "print(\"Matrix A:\")\n",
    "print(A)\n",
    "print(\"Matrix B:\")\n",
    "print(B)\n",
    "print(\"Addition of two Matrices:\")\n",
    "print(C)"
   ]
  }
